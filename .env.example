# ========================================================
# LA CALETA - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo como .env y completa con tus credenciales
# ========================================================

# Base de datos PostgreSQL (Neon, Render PostgreSQL, Supabase o local)
DATABASE_URL=jdbc:postgresql://ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=tu_password_aqui
DDL_AUTO=validate

# Puerto del servidor (en Render se asigna automáticamente mediante PORT)
PORT=8082

# Configuración de Correo SMTP (Gmail u otro proveedor)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_gmail

